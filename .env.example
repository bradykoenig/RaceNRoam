# ============================================================
# RaceNRoam Live Race Hub – Environment Variables
# Copy this file to .env for local development
# NEVER commit .env to source control
# Set these as Cloudflare Pages environment variables in production
# ============================================================

# --- Feature Flags ---
# Enable live API calls for each series (set to "false" to use fallback data)
ENABLE_LIVE_F1=true
ENABLE_LIVE_NASCAR=false
ENABLE_LIVE_INDYCAR=false
ENABLE_LIVE_IMSA_WEC=false
ENABLE_LIVE_MOTOGP=false

# --- Weather ---
# open-meteo is free and requires no key
WEATHER_PROVIDER=open-meteo
# Fallback: set to openweather and provide key below
OPENWEATHER_API_KEY=

# --- OpenF1 Real-Time API (paid) ---
# Add these as Cloudflare Pages → Settings → Environment Variables (NOT prefixed with VITE_)
# Never commit actual values. Server-side only — never exposed to browser.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# --- Paid / Official Motorsport APIs ---
# Sportradar: https://developer.sportradar.com/
SPORTSRADAR_API_KEY=

# SportsData.io: https://sportsdata.io/
SPORTSDATA_IO_API_KEY=

# DataSportsGroup: https://www.datasportsgroup.com/
DATASPORTSGROUP_API_KEY=

# Enetpulse: https://www.enetpulse.com/
ENETPULSE_API_KEY=

# Sportmonks: https://www.sportmonks.com/
SPORTMONKS_API_KEY=

# Generic / other motorsport provider key
GENERIC_MOTORSPORTS_API_KEY=

# --- Cache (Cloudflare KV) ---
# TTL values in seconds (Cloudflare Workers environment)
DEFAULT_CACHE_TTL_SECONDS=300
LIVE_CACHE_TTL_SECONDS=30
WEATHER_CACHE_TTL_SECONDS=600

# --- KV Namespace ---
# After creating a KV namespace in Cloudflare Dashboard, bind it in wrangler.toml
# RACE_HUB_CACHE binding is used by the functions/lib/utils/cache.js utility

# ── Supabase (RaceNRoam Merch Site) ──────────────────────────
# Set these as Cloudflare Pages environment variables (frontend only)
VITE_SUPABASE_URL=https://ovhihtvrunfxyjxwphzz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xWfcAHKKtiiZkX2NVN9rRw_MHApqGKa
VITE_SUPABASE_PROJECT_ID=ovhihtvrunfxyjxwphzz

# ── Supabase Edge Function Secrets ───────────────────────────
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# SUPABASE_SERVICE_ROLE_KEY is auto-injected by Supabase — do NOT add to frontend
# No email secrets needed — orders are reviewed manually via /orders page
